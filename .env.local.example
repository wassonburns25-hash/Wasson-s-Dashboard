# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The site URL used for magic-link redirects (no trailing slash).
# Locally this is http://localhost:3000 ; on Vercel set it to your deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key — powers AI calorie estimates and photo→workout import.
# Get one at https://console.anthropic.com . SECRET — set it in Vercel project
# env vars (never commit it). Without it, those AI features show a friendly
# "not configured" message and you can still enter data manually.
ANTHROPIC_API_KEY=sk-ant-...
